# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ---- Paddle (payments + worldwide tax; Paddle is merchant of record) ----
# sandbox while testing, production when live
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Developer tools > Authentication > Client-side tokens (starts with test_ or live_)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
# Developer tools > Authentication > API keys (server only)
PADDLE_API_KEY=pdl_...
# Developer tools > Notifications > your webhook > Secret key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Optional: leave blank and open /api/admin/paddle-setup?secret=CRON_SECRET to create the plans
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ELITE=

# ---- Resend (weekly emails) ----
RESEND_API_KEY=re_...
EMAIL_FROM="Liftkai <coach@yourdomain.com>"

# ---- AI (food scan + Liftkai Coach) ----
# Option 1 (free tier): Google Gemini key from aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Option 2: Anthropic (used only when GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Cron protection (any long random string) ----
CRON_SECRET=change-me-to-a-long-random-string
