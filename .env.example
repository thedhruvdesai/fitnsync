# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Set to true only once you're registered for GST (shows "GST inclusive" on AU prices)
NEXT_PUBLIC_GST_REGISTERED=false

# ---- Stripe (Developers > API keys) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: leave blank and open /api/admin/stripe-setup?secret=CRON_SECRET to create prices in every currency
STRIPE_PRICE_STARTER=price_...   # $9.99 AUD / month
STRIPE_PRICE_PRO=price_...       # $19.99 AUD / month
STRIPE_PRICE_ELITE=price_...     # $39 AUD / month

# ---- Resend (weekly emails) ----
RESEND_API_KEY=re_...
EMAIL_FROM="Fit&Sync <coach@yourdomain.com>"

# ---- Anthropic (Fit&Sync Coach) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Cron protection (any long random string) ----
CRON_SECRET=change-me-to-a-long-random-string
